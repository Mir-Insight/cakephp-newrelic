{
  "name":"mir-insight/cakephp-newrelic",
  "version": "2.0.2",
  "description":"CakePHP 5 NewRelic Integration",
  "type":"cakephp-plugin",
  "keywords":[
    "cakephp",
    "newrelic",
    "apm",
    "plugin"
  ],
  "homepage":"https://github.com/mir-insight/cakephp-newrelic",
  "license":"MIT",
  "authors":[
    {
      "name":"Christian Winther",
      "role":"Author",
      "homepage":"http://cakephp.nu/"
    },
    {
      "name":"Miguel Enes",
      "role":"Author",
      "homepage":"https://www.mirinsight.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "cakephp/cakephp": "^5.0|^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "cakephp/debug_kit": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "NewRelic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NewRelic\\Test\\": "tests/"
    }
  },
  "support":{
    "source":"https://github.com/mir-insight/cakephp-newrelic",
    "issues":"https://github.com/mir-insight/cakephp-newrelic/issues"
  },
  "minimum-stability": "stable"
}
